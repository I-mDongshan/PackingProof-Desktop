<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS/Linux 可用的保存主机：复用主工程的录像、数据库、Web 与备份代码，
    只排除 Windows 专有与摄像头采集相关的实现。
    目标框架是 net8.0（不带 -windows），因此这里引用到的文件都必须是跨平台代码。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ExpressPackingMonitoring.Host</AssemblyName>
    <RootNamespace>ExpressPackingMonitoring</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpressPackingMonitoring.Core\ExpressPackingMonitoring.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="HostOptions.cs" />
    <Compile Include="MacDeploymentSetup.cs" />
    <Compile Include="HostSession.cs" />
    <Compile Include="ViewerSession.cs" />
    <Compile Include="MenuCommands.cs" />
    <Compile Include="Platform/MacDialog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ExpressPackingMonitoring\Web\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Web/index.html</Link>
    </Content>
    <Content Include="..\ExpressPackingMonitoring\Web\kuaidizs-install-guide.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Web/kuaidizs-install-guide.html</Link>
    </Content>
  </ItemGroup>

  <!-- 第三方组件与许可证全文随包分发（macOS 主机为 PackingProofHost.app/Contents/MacOS/Host/licenses/），
       为随包携带的 FFmpeg 提供 GPL-3.0 全文与构建说明；登记见 docs\THIRD_PARTY_NOTICES.md。 -->
  <ItemGroup>
    <Content Include="..\docs\THIRD_PARTY_NOTICES.md">
      <Link>licenses/THIRD_PARTY_NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\LICENSE">
      <Link>licenses/AGPL-3.0.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\docs\third-party-licenses\*.txt">
      <Link>licenses/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
