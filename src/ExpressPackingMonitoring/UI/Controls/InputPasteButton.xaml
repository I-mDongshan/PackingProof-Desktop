<UserControl x:Class="ExpressPackingMonitoring.UI.Controls.InputPasteButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:self="clr-namespace:ExpressPackingMonitoring.UI.Controls"
             x:Name="Root"
             Focusable="False"
             IsTabStop="False"
             Cursor="Hand"
             Width="{Binding ButtonSize, ElementName=Root}"
             Height="{Binding ButtonSize, ElementName=Root}"
             ToolTip="粘贴单号，自动去掉首尾多余字符"
             AutomationProperties.Name="粘贴单号">
    <!--
        输入框右侧的"粘贴"图标：主界面扫码框与回放的单号精准搜索共用这一套外观与行为。
        粘进输入框的文本会先去掉首尾的非字母数字字符（快递公司名、空格、换行等），
        单号本身原样保留；输入框自己的 TextChanged 逻辑照常收尾。
    -->
    <Button x:Name="ClickHost"
            Click="PasteButton_Click"
            Focusable="False"
            IsTabStop="False"
            Cursor="Hand"
            Background="{StaticResource TransparentBrush}"
            BorderThickness="0">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{Binding ButtonCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type self:InputPasteButton}}}">
                    <Path Data="{StaticResource MaterialContentPasteIcon}"
                          Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type self:InputPasteButton}}}"
                          Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type self:InputPasteButton}}}"
                          Stretch="Uniform"
                          Fill="{DynamicResource TextMuted}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
